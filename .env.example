PUBLISHFLOW_PORT=8030
PUBLISHFLOW_DATABASE_URL=postgresql+psycopg://publishflow:publishflow@database:5432/publishflow
PUBLISHFLOW_RABBITMQ_URL=amqp://publishflow:publishflow@rabbitmq:5672/%2F
PUBLISHFLOW_JWT_SECRET=replace-with-a-long-random-secret
PUBLISHFLOW_ACCESS_TOKEN_EXPIRE_MINUTES=30
PUBLISHFLOW_ADMIN_EMAIL=admin@example.com
PUBLISHFLOW_ADMIN_PASSWORD=ChangeMe123!
PUBLISHFLOW_EDITOR_EMAIL=editor@example.com
PUBLISHFLOW_EDITOR_PASSWORD=ChangeMe123!
PUBLISHFLOW_LOG_LEVEL=INFO
# По умолчанию retention отключён; срок включается только явной командой --apply.
PUBLISHFLOW_ARTICLE_RETENTION_SECONDS=
PUBLISHFLOW_ARTICLE_QUEUE_MAX_BYTES=10485760
PUBLISHFLOW_ARTICLE_RETENTION_BATCH_SIZE=1000
PUBLISHFLOW_RABBITMQ_MANAGEMENT_URL=http://rabbitmq:15672
